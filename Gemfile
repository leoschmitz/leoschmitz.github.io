source "https://rubygems.org"

# Local Jekyll version. The site is deployed to GitHub Pages via a GitHub
# Actions workflow (see .github/workflows/pages.yml) that builds with this
# same Gemfile, so local and deployed output stay in sync.
#
# Run the site with:
#
#     bundle exec jekyll serve
#
gem "jekyll", "~> 4.4.1"
gem "minima", "~> 2.5"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.12"
end
